# Where the porch is (National Weather Service lookups). Default: Detroit, MI.
PORCH_LAT=42.3314
PORCH_LON=-83.0458
PORCH_DIRECT_SUN=0                    # 1 = porch gets direct sun (time budgets halved)
PORCHSAFE_HOUSEHOLD=Home

# Weather source: live (NWS) or a demo scenario: fixture:winter | fixture:heat | fixture:mild
PORCHSAFE_WEATHER=live

# Alerts: an ntfy.sh topic URL gives phone push notifications with no account (install the ntfy app)
PORCHSAFE_NOTIFY_URL=https://ntfy.sh/porchsafe-your-random-topic
PORCHSAFE_BACKUP_NAME=Neighbor
PORCHSAFE_BACKUP_NOTIFY_URL=https://ntfy.sh/porchsafe-neighbor-random-topic
PORCHSAFE_ESCALATE_AFTER_MIN=10

# Ring Partner API (Developer Portal). Either a Playground access token...
RING_ACCESS_TOKEN=
# ...or production credentials after account linking
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REFRESH_TOKEN=
RING_HMAC_KEY=porchsafe-local-demo-key   # use the HMAC Signing Key from the Ring Developer Portal
PORCHSAFE_RING_POLL=0                     # 1 = poll Event History (Playground does not deliver webhooks)

# Amazon Bedrock (optional): look at the Ring snapshot of an unexpected parcel
PORCHSAFE_BEDROCK=0
BEDROCK_VISION_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1

# Demo
PORCHSAFE_TIME_SCALE=1                    # 30 = 1 real second counts as 30 seconds
PORT=8090
